# 复制成 .env 后按需修改；本项目不会自动读取 .env，请在 shell 里 export/set。
# 全本地：Qwen3 小模型 + Qwen3 对话 + bge-m3 embedding（1024d）+ sqlite-vec
DIGITAL_LIFE_SMALL_MODEL=qwen3:1.7b
DIGITAL_LIFE_SMALL_BASE_URL=http://127.0.0.1:11434/v1
DIGITAL_LIFE_SMALL_API_KEY=ollama
DIGITAL_LIFE_BIG_MODEL=qwen3:1.7b
DIGITAL_LIFE_BASE_URL=http://127.0.0.1:11434/v1
DIGITAL_LIFE_API_KEY=ollama

# embedding：显存优先选 bge-m3（1024 维，约 689MB VRAM，中文强）；空闲 5 分钟卸载
DIGITAL_LIFE_EMBED_MODEL=bge-m3
DIGITAL_LIFE_EMBED_DIM=1024
DIGITAL_LIFE_EMBED_KEEP_ALIVE=5m

# 显存更低但中文更弱：nomic-embed-text（335MB）/ all-minilm（27MB）
# DIGITAL_LIFE_EMBED_MODEL=nomic-embed-text
# DIGITAL_LIFE_EMBED_DIM=768
# DIGITAL_LIFE_EMBED_KEEP_ALIVE=1m

# 云端大模型 + 本地 Qwen3 小模型的另一种组合：
# DIGITAL_LIFE_BIG_MODEL=deepseek-chat
# DIGITAL_LIFE_BASE_URL=https://api.deepseek.com/v1
# DIGITAL_LIFE_API_KEY=sk-...
