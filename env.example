# 复制成 .env 后按需修改；本项目不会自动读取 .env，请在 shell 里 export/set。
# 全本地：Qwen3 小模型 + Qwen3 对话 + bge-m3 embedding（1024d）+ sqlite-vec
DIGITAL_LIFE_SMALL_MODEL=qwen3:1.7b
DIGITAL_LIFE_SMALL_BASE_URL=http://127.0.0.1:11434/v1
DIGITAL_LIFE_SMALL_API_KEY=ollama
DIGITAL_LIFE_BIG_MODEL=qwen3:1.7b
DIGITAL_LIFE_BASE_URL=http://127.0.0.1:11434/v1
DIGITAL_LIFE_API_KEY=ollama

# embedding：显存优先选 bge-m3（1024 维，约 689MB VRAM，中文强）；空闲 5 分钟卸载
DIGITAL_LIFE_EMBED_MODEL=bge-m3
DIGITAL_LIFE_EMBED_DIM=1024
DIGITAL_LIFE_EMBED_KEEP_ALIVE=5m

# 显存更低但中文更弱：nomic-embed-text（335MB）/ all-minilm（27MB）
# DIGITAL_LIFE_EMBED_MODEL=nomic-embed-text
# DIGITAL_LIFE_EMBED_DIM=768
# DIGITAL_LIFE_EMBED_KEEP_ALIVE=1m

# 云端大模型 + 本地 Qwen3 小模型的另一种组合：
# DIGITAL_LIFE_BIG_MODEL=deepseek-chat
# DIGITAL_LIFE_BASE_URL=https://api.deepseek.com/v1
# DIGITAL_LIFE_API_KEY=sk-...

# ---- QQ 通道（OneBot 11，正向 WebSocket；需要 pip install -e ".[im]"）----
# 地址/令牌与 NapCat 的 onebot11_<QQ号>.json 里 websocketServers 保持一致
DIGITAL_LIFE_QQ_WS=ws://127.0.0.1:3001
DIGITAL_LIFE_QQ_TOKEN=改成你的 access_token
DIGITAL_LIFE_QQ_SELF_ID=机器人QQ号
# 私聊：off 不接 / allowlist 只接白名单 / open 谁都接
DIGITAL_LIFE_QQ_PRIVATE_MODE=allowlist
DIGITAL_LIFE_QQ_PRIVATE_ALLOW=你的QQ号
# 群聊：off 不接 / mention 被 @ 或带前缀才接 / open 群里什么都接
#       ambient 会自己插话：没被 @ 的群消息只旁听（不生成、不发），偶尔接一句
DIGITAL_LIFE_QQ_GROUP_MODE=mention
# 留空 = 不限制群；写了群号 = 只在这些群接话
DIGITAL_LIFE_QQ_GROUP_ALLOW=
# ambient 专用：每条消息的接话概率、两次接话的最小间隔（秒）、叫她名字的关键词
DIGITAL_LIFE_QQ_GROUP_PROB=0.06
DIGITAL_LIFE_QQ_GROUP_COOLDOWN=180
DIGITAL_LIFE_QQ_GROUP_NAMES=夏弥,小龙女,虾米

# ---- 表情包与看图 ----
# 表情包目录；给了才会发表情包
DIGITAL_LIFE_QQ_STICKERS=
# 可选：{path, summary} 列表，挑图时按 summary 里的关键词撞当前 mood
DIGITAL_LIFE_QQ_STICKER_META=
# 每条回复补一张表情包的概率、跟在这句话后面的间隔秒数
DIGITAL_LIFE_QQ_STICKER_PROB=0.15
DIGITAL_LIFE_QQ_STICKER_DELAY=0.8
# 收到图片/表情包时用多模态模型看一眼，换成一句描述（0=关，只显示占位）
DIGITAL_LIFE_QQ_VISION=1
# 把"旁听"的群消息也打进日志
DIGITAL_LIFE_QQ_VERBOSE=0
# 群聊里不带 @ 也能触发的前缀；置空则只认 @
DIGITAL_LIFE_QQ_PREFIX=/
# 多条气泡的间隔秒数、慢循环节拍秒数、同时处理的消息数
DIGITAL_LIFE_QQ_BUBBLE_INTERVAL=0.6
# 她一句话分两口气时：1=按两条气泡发（像真人连发），0=并成一条
DIGITAL_LIFE_QQ_SPLIT=1
DIGITAL_LIFE_QQ_TICK=60
DIGITAL_LIFE_QQ_CONCURRENCY=4
